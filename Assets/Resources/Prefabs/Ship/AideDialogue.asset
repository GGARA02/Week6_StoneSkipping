  _dialogues:
  - _expression: 0
    _portrait: "\uC900\uBE44\uB410\uC5B4? \uB0B4\uAC00 \uC9C0\uCF1C\uBCFC\uAC8C."
    _projectile: "\uC774\uBC88\uC5D4 \uB0B4\uAC00 \uB0A0\uC544\uAC00\uB294 \uAC70\uC57C?"
  - _expression: 1
    _portrait: "\uC870\uAE08\uB9CC \uB354 \uC9D1\uC911\uD574 \uC918!"
    _projectile: "\uADF8\uCABD\uC740 \uBCBD\uC774\uC796\uC544!"
