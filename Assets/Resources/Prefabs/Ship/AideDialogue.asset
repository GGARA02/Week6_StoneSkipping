  - _expression: 3
    _portrait: "\uBD24\uC9C0? \uC774 \uC815\uB3C4\uB294 \uAC04\uB2E8\uD574!"
    _projectile: "\uBD24\uC5B4? \uC644\uBCBD\uD55C \uBE44\uD589\uC774\uC57C!"
  - _expression: 4
    _portrait: "\uAD1C\uCC2E\uC544, \uB2E4\uC74C\uC5D4 \uB9DE\uCD9C \uC218 \uC788\uC5B4."
    _projectile: "\uC557, \uBC29\uAE08 \uC880 \uD754\uB4E4\uB838\uC5B4!"
  - _expression: 5
    _portrait: "\uC7A0\uAE50, \uC5F0\uACB0\uC774 \uB04A\uAE30\uACE0 \uC788\uC5B4\u2026!"
    _projectile: "\uC73C\uC544! \uC870\uC2EC\uD574\uC11C \uB358\uC838 \uC918!"
  - _expression: 6
    _portrait: "\uADF8\uB807\uAC8C \uC798\uD558\uBA74 \uC880 \uBD80\uB044\uB7FD\uC796\uC544."
    _projectile: "\uC0DD\uAC01\uBCF4\uB2E4 \uC798 \uB358\uC9C0\uB124\u2026!"
  - _expression: 7
    _portrait: "\uBC29\uAE08 \uADF8 \uD310\uB2E8, \uAF64 \uC88B\uC558\uC5B4."
    _projectile: "\uC88B\uC544, \uC774\uB300\uB85C \uACC4\uC18D \uAC00\uC790!"
  - _expression: 8
    _portrait: "\uC88B\uC544! \uC815\uB9D0 \uC798\uD558\uACE0 \uC788\uC5B4!"
    _projectile: "\uD55C \uBC88 \uB354! \uB354 \uBA40\uB9AC \uB0A0\uC544\uAC00\uC790!"
